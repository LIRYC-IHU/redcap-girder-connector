{
    "name": "Girder Uploader",
    "namespace": "ExternalModules\\GirderUploaderModule",
    "description": "Upload files to Girder with Chunked Upload.",
    "framework-version": 12,
    "authors": [
        {
            "name": "Josselin Duchateau",
            "email": "josselin.duchateau@ihu-liryc.fr",
            "institution": "IHU Liryc - University of Bordeaux"
        }
    ],
    "compatibility": {
        "php-version-min": "8.1.0"
    },
    "auth-ajax-actions": [
        "init-batch",
        "init-file-upload",
        "upload-file",
        "refresh-upload-metadata",
        "delete-upload-contents",
        "pseudonym-evaluate",
        "pseudonym-check",
        "pseudonym-register"
    ],
    "system-settings": [
        {
            "key": "pseudonym-redcap-key",
            "name": "<b>REDCap pseudonym key</b> - the secret behind patient signatures, date offsets and UIDs, 64 hex characters; generated when empty. <b>Never change it once files have been uploaded</b>, and back it up like an encryption key",
            "type": "text",
            "required": false
        },
        {
            "key": "pseudonym-daily-limit",
            "name": "<b>Pseudonym evaluations per 24 hours, per project</b> - default 500",
            "type": "text",
            "default": "500",
            "required": false
        }
    ],
    "project-settings": [
        {
            "key": "girder-backchannel-api-url",
            "name": "<b>Girder Backchannel API URL</b> - ex: https://girder.your-server.com/api/v1",
            "type": "text",
            "required": true
        },
        {
            "key": "girder-frontchannel-base-url",
            "name": "<b>Girder Frontchannel Base URL</b> - ex: https://girder.your-server.com",
            "type": "text",
            "required": true
        },
        {
            "key": "api-key",
            "name": "<b>Girder API Key</b> - generate an API key for your user in Girder and paste it here",
            "type": "text",
            "required": true
        },
        {
            "key": "root-collection-id",
            "name": "<b>Root Collection ID</b> - uploaded files will be stored in Girder under this collection",
            "type": "text",
            "required": true
        },
        {
            "key": "chunk-size",
            "name": "<b>Chunk Size (in bytes)</b> - default is 10MB",
            "type": "text",
            "default": "10485760",
            "required": false
        },
        {
            "key": "max-retries",
            "name": "<b>Max Retries</b> - default is 3",
            "type": "text",
            "default": "3",
            "required": false
        },
        {
            "key": "retry-delay",
            "name": "<b>Retry Delay (in milliseconds)</b> - default is 1000ms",
            "type": "text",
            "default": "1000",
            "required": false
        },
        {
            "key": "deidentify-dicom",
            "name": "<b>Enable DICOM Deidentification</b> - deidentify supported DICOM files before upload",
            "type": "checkbox",
            "default": "1",
            "required": false
        },
        {
            "key": "deidentify-xml-ecg",
            "name": "<b>Enable XML ECG Deidentification</b> - deidentify supported ECG XML files before upload",
            "type": "checkbox",
            "default": "1",
            "required": false
        },
        {
            "key": "deidentify-schiller-holter",
            "name": "<b>Enable Schiller Holter Deidentification</b> - deidentify supported Schiller Holter files before upload",
            "type": "checkbox",
            "default": "1",
            "required": false
        },
        {
            "key": "pseudonym-fingerprint-check",
            "name": "<b>Check the patient's signature</b> - warn before an upload whose files do not match the record's earlier uploads: the uploader can still confirm it, which is logged (compared by a two-character keyed signature of the NIP, never the NIP itself)",
            "type": "checkbox",
            "default": "1",
            "required": false
        },
        {
            "key": "pseudonym-domain",
            "name": "<b>Pseudonym domain</b> - separates this project's pseudonyms from every other project's; filled in as <code>redcap:&lt;project id&gt;</code> when empty. <b>Do not change it once files have been uploaded</b>",
            "type": "text",
            "required": false
        },
        {
            "key": "preserve-upload-folder-architecture",
            "name": "<b>Preserve Upload Folder Architecture</b> - off by default: files are stored at field root with neutral names (0001.ext to 9999.ext), since folder and file names can carry the patient's identity",
            "type": "checkbox",
            "required": false
        }
    ],
    "action-tags": [
        {
            "tag": "@GIRDER_UPLOAD",
            "description": "Transform this field into a Drag & Drop area for Girder.",
            "allowed_field_types": [
                "textarea"
            ]
        }
    ],
    "links": {
        "project": [
            {
                "name": "Girder Collection",
                "icon": "fas fa-folder-open",
                "url": "http://COLLECTION_ID",
                "show-header-and-footer": false
            }
        ]
    }
}
